{
  "name": "ompide",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "npm@10.9.2",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "lint": "eslint src scripts vite.config.ts",
    "format": "eslint ./src --fix && prettier --write ./src",
    "format:check": "prettier --check ./src && eslint ./src",
    "audit:localization": "node scripts/audit-localization.mjs",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run",
    "tools:prepare": "node scripts/prepare-tools.mjs",
    "fixtures:prepare": "node scripts/prepare-fixtures.mjs",
    "test:tools": "cargo build --manifest-path src-tauri/Cargo.toml -p pawn-core --bin pawn-lsp-bridge && node scripts/verify-tools.mjs",
    "tools:build-lsp": "node scripts/build-pawnlsp.mjs"
  },
  "dependencies": {
    "@codingame/monaco-vscode-api": "37.6.0",
    "@codingame/monaco-vscode-configuration-service-override": "37.6.0",
    "@codingame/monaco-vscode-files-service-override": "37.6.0",
    "@codingame/monaco-vscode-keybindings-service-override": "37.6.0",
    "@codingame/monaco-vscode-textmate-service-override": "37.6.0",
    "@codingame/monaco-vscode-theme-service-override": "37.6.0",
    "@tauri-apps/api": "2.12.4",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "monaco-editor": "npm:@codingame/monaco-vscode-editor-api@37.6.0",
    "monaco-languageclient": "11.0.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "vscode": "npm:@codingame/monaco-vscode-extension-api@37.6.0",
    "vscode-jsonrpc": "9.0.1",
    "vscode-languageclient": "10.1.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@playwright/test": "1.64.1",
    "@stylistic/eslint-plugin": "5.10.0",
    "@tauri-apps/cli": "2.12.4",
    "@types/node": "^22.19.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "^10.0.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.0.0",
    "vite": "8.3.5",
    "vitest": "^4.1.0"
  },
  "overrides": {
    "@codingame/monaco-vscode-api": "37.6.0",
    "@codingame/monaco-vscode-configuration-service-override": "37.6.0",
    "@codingame/monaco-vscode-editor-api": "37.6.0",
    "@codingame/monaco-vscode-editor-service-override": "37.6.0",
    "@codingame/monaco-vscode-extensions-service-override": "37.6.0",
    "@codingame/monaco-vscode-files-service-override": "37.6.0",
    "@codingame/monaco-vscode-language-pack-cs": "37.6.0",
    "@codingame/monaco-vscode-language-pack-de": "37.6.0",
    "@codingame/monaco-vscode-language-pack-es": "37.6.0",
    "@codingame/monaco-vscode-language-pack-fr": "37.6.0",
    "@codingame/monaco-vscode-language-pack-it": "37.6.0",
    "@codingame/monaco-vscode-language-pack-ja": "37.6.0",
    "@codingame/monaco-vscode-language-pack-ko": "37.6.0",
    "@codingame/monaco-vscode-language-pack-pl": "37.6.0",
    "@codingame/monaco-vscode-language-pack-pt-br": "37.6.0",
    "@codingame/monaco-vscode-language-pack-qps-ploc": "37.6.0",
    "@codingame/monaco-vscode-language-pack-ru": "37.6.0",
    "@codingame/monaco-vscode-language-pack-tr": "37.6.0",
    "@codingame/monaco-vscode-language-pack-zh-hans": "37.6.0",
    "@codingame/monaco-vscode-language-pack-zh-hant": "37.6.0",
    "@codingame/monaco-vscode-languages-service-override": "37.6.0",
    "@codingame/monaco-vscode-localization-service-override": "37.6.0",
    "@codingame/monaco-vscode-log-service-override": "37.6.0",
    "@codingame/monaco-vscode-model-service-override": "37.6.0",
    "@codingame/monaco-vscode-monarch-service-override": "37.6.0",
    "@codingame/monaco-vscode-textmate-service-override": "37.6.0",
    "@codingame/monaco-vscode-theme-defaults-default-extension": "37.6.0",
    "@codingame/monaco-vscode-theme-service-override": "37.6.0",
    "@codingame/monaco-vscode-views-service-override": "37.6.0",
    "@codingame/monaco-vscode-workbench-service-override": "37.6.0"
  }
}
