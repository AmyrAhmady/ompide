@@ -0,0 +1,32 @@
+package paths
+
+import (
+	"github.com/pawnkit/pawn-project/manifest"
+	"testing"
+)
+
+func TestExternalSDKInputsPreserveSourceAndOutputBoundary(t *testing.T) {
+	for _, tc := range []struct{ root, include, want string }{
+		{"/project", "../shared SDK", "/shared SDK"},
+		{"/project", "/opt/shared SDK", "/opt/shared SDK"},
+		{"C:/project", `..\shared SDK`, "C:/shared SDK"},
+		{"C:/project", `D:\SDK\include`, "D:/SDK/include"},
+	} {
+		t.Run(tc.root+tc.include, func(t *testing.T) {
+			m := &manifest.Manifest{Entry: "main.pwn", IncludePath: tc.include}
+			result, err := Resolve(tc.root, m)
+			if err != nil || len(result.IncludeRoots) != 1 || result.IncludeRoots[0] != tc.want {
+				t.Fatalf("result=%+v err=%v", result, err)
+			}
+			m.Entry = "../outside.pwn"
+			if _, err := Resolve(tc.root, m); err == nil {
+				t.Fatal("external entry accepted")
+			}
+			m.Entry = "main.pwn"
+			m.Output = "../outside.amx"
+			if _, err := Resolve(tc.root, m); err == nil {
+				t.Fatal("external output accepted")
+			}
+		})
+	}
+}
