diff --git a/lsp/workspace_diagnostics_reuse_test.go b/lsp/workspace_diagnostics_reuse_test.go
new file mode 100644
--- /dev/null
+++ b/lsp/workspace_diagnostics_reuse_test.go
@@ -0,0 +1,49 @@
+package lsp
+
+import (
+	"context"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+
+	analysis "github.com/pawnkit/pawn-analysis"
+	"github.com/pawnkit/pawn-analysis/preprocess"
+)
+
+func TestWorkspaceDiagnosticsFollowArgumentEdits(t *testing.T) {
+	root := t.TempDir()
+	entry := filepath.Join(root, "main.pwn")
+	valid := "#include \"math.inc\"\nmain() { return Add(1, 2); }\n"
+	for name, text := range map[string]string{
+		"pawn.json": `{"entry":"main.pwn"}`,
+		"main.pwn":  valid,
+		"math.inc":  "stock Add(left, right) { return left + right; }\n",
+	} {
+		if err := os.WriteFile(filepath.Join(root, name), []byte(text), 0o600); err != nil {
+			t.Fatal(err)
+		}
+	}
+	includes, _, projectRoot, resolvedEntry := loadProjectContext(entry)
+	cache := preprocess.NewTokenCache()
+	var previous *analysis.Result
+	for _, invalid := range []bool{false, true, false, true, false} {
+		text := valid
+		if invalid {
+			text = strings.Replace(text, "Add(1, 2)", "Add(1)", 1)
+		}
+		current, err := analyzeWorkspaceEntry(context.Background(), projectRoot, resolvedEntry,
+			map[string][]byte{workspacePathKey(entry): []byte(text)}, includes, nil, cache, previous)
+		if err != nil {
+			t.Fatal(err)
+		}
+		found := false
+		for _, finding := range current.Diagnostics {
+			found = found || strings.HasSuffix(finding.Code, "sema/argument-count")
+		}
+		if found != invalid {
+			t.Fatalf("invalid=%v, argument diagnostic=%v: %#v", invalid, found, current.Diagnostics)
+		}
+		previous = current
+	}
+}
