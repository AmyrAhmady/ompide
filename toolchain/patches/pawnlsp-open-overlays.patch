@@ -0,0 +1,98 @@
+package lsp
+
+import (
+	"bufio"
+	"bytes"
+	"encoding/json"
+	"io"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+
+	coresource "github.com/pawnkit/pawnkit-core/source"
+)
+
+func TestUnsavedIncludeRefreshesOpenParent(t *testing.T) {
+	root := t.TempDir()
+	mainPath := filepath.Join(root, "main.pwn")
+	includePath := filepath.Join(root, "config.inc")
+	mainText := "#include \"config.inc\"\nmain() { return LIMIT; }\n"
+	diskText := "#define LIMIT 10\nstock IncludedHelper() {}\n"
+	for name, text := range map[string]string{
+		"pawn.json":  `{"entry":"main.pwn"}`,
+		"main.pwn":   mainText,
+		"config.inc": diskText,
+	} {
+		if err := os.WriteFile(filepath.Join(root, name), []byte(text), 0o600); err != nil {
+			t.Fatal(err)
+		}
+	}
+	mainURI, includeURI := coresource.FileURI(mainPath).String(), coresource.FileURI(includePath).String()
+	var input bytes.Buffer
+	send := func(id int, method string, params any) {
+		message := map[string]any{"jsonrpc": "2.0", "method": method, "params": params}
+		if id != 0 {
+			message["id"] = id
+		}
+		frame(t, &input, message)
+	}
+	hover := func(id int) {
+		send(id, "textDocument/hover", map[string]any{"textDocument": map[string]any{"uri": mainURI}, "position": map[string]any{"line": 1, "character": 18}})
+	}
+	open := func(uri, text string) {
+		send(0, "textDocument/didOpen", map[string]any{"textDocument": map[string]any{"uri": uri, "languageId": "pawn", "version": 1, "text": text}})
+	}
+	send(1, "initialize", map[string]any{})
+	open(mainURI, mainText)
+	hover(2)
+	open(includeURI, strings.Replace(diskText, "10", "20", 1))
+	hover(3)
+	for version := 2; version <= 12; version++ {
+		send(0, "textDocument/didChange", map[string]any{
+			"textDocument":   map[string]any{"uri": includeURI, "version": version},
+			"contentChanges": []any{map[string]any{"text": strings.Replace(diskText, "10", "30", 1)}},
+		})
+	}
+	hover(4)
+	send(6, "workspace/symbol", map[string]any{"query": "IncludedHelper"})
+	send(0, "textDocument/didClose", map[string]any{"textDocument": map[string]any{"uri": includeURI}})
+	hover(5)
+	send(0, "exit", nil)
+	var output bytes.Buffer
+	if err := Run(&input, &output); err != nil {
+		t.Fatal(err)
+	}
+	reader := bufio.NewReader(&output)
+	responses := map[int]string{}
+	for {
+		body, err := readFrame(reader)
+		if err == io.EOF {
+			break
+		}
+		if err != nil {
+			t.Fatal(err)
+		}
+		var message struct {
+			ID     int    `json:"id"`
+			Method string `json:"method"`
+		}
+		if err := json.Unmarshal(body, &message); err != nil {
+			t.Fatal(err)
+		}
+		if message.ID != 0 && message.Method == "" {
+			responses[message.ID] = string(body)
+		}
+	}
+	for id, value := range map[int]string{2: "#define LIMIT 10", 3: "#define LIMIT 20", 4: "#define LIMIT 30", 5: "#define LIMIT 10"} {
+		if !strings.Contains(responses[id], value) {
+			t.Fatalf("hover %d = %s; want %q", id, responses[id], value)
+		}
+	}
+	if !strings.Contains(responses[6], includeURI) || !strings.Contains(responses[6], "IncludedHelper") {
+		t.Fatalf("included workspace symbol missing: %s", responses[6])
+	}
+	if actual, err := os.ReadFile(includePath); err != nil || string(actual) != diskText {
+		t.Fatalf("unsaved buffer changed disk: %q, %v", actual, err)
+	}
+}
