+package lsp
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"strings"
+	"testing"
+	"time"
+
+	analysis "github.com/pawnkit/pawn-analysis"
+	coresource "github.com/pawnkit/pawnkit-core/source"
+)
+
+func TestCachedInteractiveRequestsUseLiveTextWhileAnalysisAndIndexingArePending(t *testing.T) {
+	const uri = "file:///main.pwn"
+	old := []byte("native SendClientMessage(playerid, const message[]);\nmain() {\n new ownLocal;\n \n}\nother() { new foreignLocal; }\n")
+	result, err := analysis.AnalyzeContext(context.Background(), old, analysis.Options{URI: coresource.URI(uri), RetainExpanded: true})
+	if err != nil {
+		t.Fatal(err)
+	}
+	cache, err := buildInteractiveCache(context.Background(), &document{URI: uri, Text: old, Analysis: result})
+	if err != nil {
+		t.Fatal(err)
+	}
+	var output bytes.Buffer
+	doc := &document{URI: uri, Text: old, Version: 2, analysisReady: make(chan struct{})}
+	s := &server{
+		out: &output, documents: map[string]*document{uri: doc}, interactive: map[string]*interactiveCache{uri: cache},
+		workspaces: map[string]*workspaceIndex{"pending": {ready: make(chan struct{})}},
+	}
+	request := func(method, insertion string) string {
+		t.Helper()
+		output.Reset()
+		live := bytes.Replace(old, []byte("\n \n"), []byte("\n "+insertion+"\n"), 1)
+		doc.Text, doc.Index = live, coresource.NewLineIndexBytes(live)
+		offset := bytes.Index(live, []byte("\n "+insertion+"\n")) + 2 + len(insertion)
+		params, _ := json.Marshal(map[string]any{"textDocument": map[string]any{"uri": uri}, "position": offsetPosition(live, offset)})
+		ctx, cancel := context.WithTimeout(context.Background(), 200*time.Millisecond)
+		defer cancel()
+		var err error
+		if method == "completion" {
+			err = s.completion(ctx, json.RawMessage("1"), params)
+		} else {
+			err = s.signatureHelp(ctx, json.RawMessage("1"), params)
+		}
+		if err != nil {
+			t.Fatalf("cached %s waited for pending analysis: %v", method, err)
+		}
+		return output.String()
+	}
+	if body := request("completion", "SendCli"); !strings.Contains(body, `"label":"SendClientMessage"`) {
+		t.Fatalf("cached completion missing: %s", body)
+	}
+	if body := request("completion", "own"); !strings.Contains(body, `"label":"ownLocal"`) {
+		t.Fatalf("local missing after shifted edit: %s", body)
+	}
+	if body := request("completion", "foreign"); strings.Contains(body, `"label":"foreignLocal"`) {
+		t.Fatalf("local escaped its function: %s", body)
+	}
+	if body := request("signature", "SendClientMessage(1, "); !strings.Contains(body, `"activeParameter":1`) || !strings.Contains(body, "const message[]") {
+		t.Fatalf("signature ignored live arguments: %s", body)
+	}
+	// A refreshed dictionary replaces both candidates and cached signatures.
+	updated := bytes.ReplaceAll(old, []byte("SendClientMessage(playerid, const message[])"), []byte("SendOther(value)"))
+	result, err = analysis.AnalyzeContext(context.Background(), updated, analysis.Options{URI: coresource.URI(uri), RetainExpanded: true})
+	if err != nil {
+		t.Fatal(err)
+	}
+	refreshed, err := buildInteractiveCache(context.Background(), &document{URI: uri, Text: updated, Analysis: result})
+	if err != nil {
+		t.Fatal(err)
+	}
+	s.interactive[uri] = refreshed
+	if body := request("completion", "Send"); !strings.Contains(body, `"label":"SendOther"`) || strings.Contains(body, `"label":"SendClientMessage"`) {
+		t.Fatalf("refresh retained removed candidate: %s", body)
+	}
+	if body := request("signature", "SendOther("); !strings.Contains(body, "SendOther(value)") {
+		t.Fatalf("refreshed signature missing: %s", body)
+	}
+	if err := s.didClose(json.RawMessage(`{"textDocument":{"uri":"file:///main.pwn"}}`)); err != nil {
+		t.Fatal(err)
+	}
+	if s.interactive[uri] != nil {
+		t.Fatal("closed document retained its interactive cache")
+	}
+}
+
+func TestCachedSourceOffsetsPreserveUnicodeAndCRLF(t *testing.T) {
+	old := []byte("// 😀\r\nmain() {\r\n new value;\r\n value;\r\n}\r\n")
+	at := bytes.Index(old, []byte(" value;"))
+	live := append(append(append([]byte{}, old[:at]...), []byte(" // hello\r\n")...), old[at:]...)
+	offset := bytes.LastIndex(live, []byte("value;"))
+	mapped, local := cachedSourceOffset(old, live, offset)
+	if !local || mapped != bytes.LastIndex(old, []byte("value;")) {
+		t.Fatalf("mapped=%d locals=%v", mapped, local)
+	}
+	// When multiple edits make a cursor's old scope ambiguous, omit locals.
+	if _, local := cachedSourceOffset([]byte("a unchanged b"), []byte("new changed text"), 6); local {
+		t.Fatal("ambiguous edit retained local scope")
+	}
+}
+
+func TestWorkspaceAnalysisRevisionTracksOnlyIncludeOverlays(t *testing.T) {
+	open := map[string][]byte{"/main.pwn": []byte("main() {}"), "/config.inc": []byte("#define VALUE 1")}
+	first := workspaceAnalysisRevision("/", "/main.pwn", open)
+	open["/main.pwn"] = []byte("main() { return 1; }")
+	if workspaceAnalysisRevision("/", "/main.pwn", open) != first {
+		t.Fatal("entry edit invalidated reusable include expansion")
+	}
+	open["/config.inc"] = []byte("#define VALUE 2")
+	if workspaceAnalysisRevision("/", "/main.pwn", open) == first {
+		t.Fatal("include edit retained stale preprocessing revision")
+	}
+}
+
+func TestInteractiveRefreshWaitsForIdleAndCancelsSupersededUpdates(t *testing.T) {
+	if documentPublishDebounce != time.Second {
+		t.Fatalf("idle delay = %s", documentPublishDebounce)
+	}
+	uri := tempDocumentURI(t)
+	s := &server{documents: map[string]*document{}}
+	defer func() { s.cancelDocuments(); s.workers.Wait() }()
+	open, _ := json.Marshal(map[string]any{"textDocument": map[string]any{"uri": uri, "version": 1, "text": "main() {}\n"}})
+	if err := s.didOpen(open); err != nil {
+		t.Fatal(err)
+	}
+	s.readyDocument(uri)
+	var superseded *document
+	for version := 2; version <= 3; version++ {
+		change, _ := json.Marshal(map[string]any{"textDocument": map[string]any{"uri": uri, "version": version}, "contentChanges": []any{map[string]any{"text": "main() { new latest; }\n"}}})
+		if err := s.didChange(change); err != nil {
+			t.Fatal(err)
+		}
+		if version == 2 {
+			superseded = s.document(uri)
+		}
+	}
+	latest := s.document(uri)
+	select {
+	case <-latest.analysisReady:
+		t.Fatal("refresh ran before idle delay")
+	case <-time.After(100 * time.Millisecond):
+	}
+	waitForSignal(t, superseded.analysisReady, "superseded refresh cancellation")
+	if superseded.Analysis != nil {
+		t.Fatal("superseded update was analyzed instead of cancelled")
+	}
+	waitForSignal(t, latest.analysisReady, "idle refresh")
+	if doc := s.completionDocument(uri); doc == nil || doc.Version != 3 {
+		t.Fatalf("cache did not advance to latest version: %+v", doc)
+	}
+}
+
+func TestInlayHintsReuseUnchangedCallsWithLivePositions(t *testing.T) {
+	const uri = "file:///main.pwn"
+	old := []byte("native Message(playerid, colour);\r\nmain() { Message(1, 2); Message(3, 4); }\r\n")
+	result := analysis.Analyze(old, analysis.Options{URI: coresource.URI(uri), RetainExpanded: true})
+	cache, err := buildInteractiveCache(context.Background(), &document{URI: uri, Text: old, Analysis: result})
+	if err != nil {
+		t.Fatal(err)
+	}
+	var output bytes.Buffer
+	live := &document{URI: uri, analysisReady: make(chan struct{})}
+	s := &server{out: &output, documents: map[string]*document{uri: live}, interactive: map[string]*interactiveCache{uri: cache}}
+	query := func(current []byte) string {
+		t.Helper()
+		output.Reset()
+		live.Text = current
+		params, _ := json.Marshal(map[string]any{"textDocument": map[string]any{"uri": uri}, "range": lspRange{End: offsetPosition(current, len(current))}})
+		ctx, cancel := context.WithTimeout(context.Background(), 200*time.Millisecond)
+		defer cancel()
+		if err := s.inlayHints(ctx, json.RawMessage("1"), params); err != nil {
+			t.Fatal(err)
+		}
+		return output.String()
+	}
+	moved := bytes.Replace(old, []byte("main()"), []byte("// 😀\r\nmain()"), 1)
+	if body := query(moved); strings.Count(body, `"label":"playerid:"`) != 2 || strings.Count(body, `"line":2`) != 4 {
+		t.Fatalf("shifted hints missing: %s", body)
+	}
+	changed := bytes.Replace(old, []byte("Message(1, 2)"), []byte("Changed(1, 2)"), 1)
+	if body := query(changed); strings.Count(body, `"label":"playerid:"`) != 1 {
+		t.Fatalf("edited call reused stale hints or removed untouched call: %s", body)
+	}
+}
