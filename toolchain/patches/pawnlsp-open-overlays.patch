+
+// Include overlays must invalidate incremental preprocessing even if the entry
+// text is unchanged. Entry-only edits can still reuse compatible analysis.
+func workspaceAnalysisRevision(root, entry string, open map[string][]byte) string {
+	keys := make([]string, 0, len(open))
+	for path := range open {
+		if workspacePathKey(path) != workspacePathKey(entry) {
+			keys = append(keys, path)
+		}
+	}
+	sort.Strings(keys)
+	hash := sha256.New()
+	for _, path := range keys {
+		text := open[path]
+		fmt.Fprintf(hash, "%d:%s%d:", len(path), path, len(text))
+		hash.Write(text)
+	}
+	return fmt.Sprintf("%s:%x", root, hash.Sum(nil))
+}
