+package lsp
+
+import (
+	"bytes"
+	"encoding/json"
+	"strings"
+	"testing"
+	"time"
+)
+
+func TestInteractiveRequestsAllowCancellationDuringAnalysis(t *testing.T) {
+	t.Parallel()
+	for _, method := range []string{"textDocument/completion", "textDocument/signatureHelp"} {
+		t.Run(method, func(t *testing.T) {
+			t.Parallel()
+			const uri = "file:///main.pwn"
+			doc := &document{URI: uri, analysisReady: make(chan struct{})}
+			var output bytes.Buffer
+			s := &server{out: &output, documents: map[string]*document{uri: doc}}
+			request := message{
+				ID: json.RawMessage("1"), Method: method,
+				Params: json.RawMessage(`{"textDocument":{"uri":"file:///main.pwn"},"position":{"line":0,"character":0}}`),
+			}
+			returned := make(chan error, 1)
+			go func() {
+				_, err := s.handle(request)
+				returned <- err
+			}()
+			select {
+			case err := <-returned:
+				if err != nil {
+					t.Fatal(err)
+				}
+			case <-time.After(time.Second):
+				close(doc.analysisReady)
+				<-returned
+				s.requestWorkers.Wait()
+				t.Fatal("request blocked processing while analysis was pending")
+			}
+			s.cancelRequest(json.RawMessage(`{"id":1}`))
+			s.requestWorkers.Wait()
+			if !strings.Contains(output.String(), `"code":-32800`) {
+				t.Fatalf("missing cancellation response: %s", output.String())
+			}
+		})
+	}
+}
