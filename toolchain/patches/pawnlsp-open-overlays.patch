new file mode 100644
index 0000000..291d4c0
--- /dev/null
+++ b/lsp/diagnostics_stability_test.go
@@ -0,0 +1,100 @@
+package lsp
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"strings"
+	"testing"
+	"time"
+
+	analysis "github.com/pawnkit/pawn-analysis"
+	coresource "github.com/pawnkit/pawnkit-core/source"
+	lintdiagnostic "github.com/pawnkit/pawnlint/pkg/diagnostic"
+)
+
+func TestDiagnosticContentIDTracksVisibleContentNotOrder(t *testing.T) {
+	first := lspDiagnostic{Message: "warning", Severity: 2, Code: "rule", Source: "pawnlint"}
+	second := lspDiagnostic{Message: "another warning", Severity: 2}
+	original := diagnosticContentID([]lspDiagnostic{first, second})
+	if diagnosticContentID([]lspDiagnostic{second, first}) != original {
+		t.Fatal("ordering changed content ID")
+	}
+	for _, field := range []string{"message", "severity", "range", "source", "code", "documentation", "related"} {
+		changed := first
+		switch field {
+		case "message":
+			changed.Message = "changed"
+		case "severity":
+			changed.Severity = 1
+		case "range":
+			changed.Range.Start.Line = 1
+		case "source":
+			changed.Source = "other"
+		case "code":
+			changed.Code = "other"
+		case "documentation":
+			changed.CodeDescription = &lspCodeDescription{Href: "https://example.com/rule"}
+		case "related":
+			changed.RelatedInformation = []lspDiagnosticRelatedInformation{{Message: "related"}}
+		}
+		if diagnosticContentID([]lspDiagnostic{changed, second}) == original {
+			t.Fatalf("%s did not change ID", field)
+		}
+	}
+	if diagnosticContentID(nil) != diagnosticContentID([]lspDiagnostic{}) {
+		t.Fatal("empty reports differ")
+	}
+}
+
+func TestDiagnosticRefreshRetainsCompleteReportUntilLintFinishes(t *testing.T) {
+	const uri = "file:///main.pwn"
+	text := []byte("main() {}\n")
+	result := analysis.Analyze(text, analysis.Options{URI: coresource.URI(uri)})
+	previous := &document{URI: uri, Text: text, Version: 1, Analysis: result, analysisReady: closedChannel(), ready: closedChannel(), Diagnostics: []lintdiagnostic.Diagnostic{{RuleID: "style", Message: "existing warning"}}}
+	var output bytes.Buffer
+	s := &server{out: &output, documents: map[string]*document{uri: previous}}
+	params, _ := json.Marshal(map[string]any{"textDocument": map[string]any{"uri": uri}})
+	if err := s.documentDiagnostics(context.Background(), json.RawMessage("1"), params); err != nil {
+		t.Fatal(err)
+	}
+	id := diagnosticContentID(s.documentDiagnosticItems(previous, true, nil))
+	next := &document{URI: uri, Text: text, Version: 2, Analysis: result, analysisReady: closedChannel(), ready: make(chan struct{})}
+	s.documents[uri] = next
+	params, _ = json.Marshal(map[string]any{"textDocument": map[string]any{"uri": uri}, "previousResultId": id})
+	output.Reset()
+	done := make(chan error, 1)
+	go func() { done <- s.documentDiagnostics(context.Background(), json.RawMessage("2"), params) }()
+	select {
+	case <-done:
+		t.Fatal("incomplete lint report replaced existing warnings")
+	case <-time.After(40 * time.Millisecond):
+	}
+	next.Diagnostics = previous.Diagnostics
+	close(next.ready)
+	if err := <-done; err != nil {
+		t.Fatal(err)
+	}
+	if !strings.Contains(output.String(), `"kind":"unchanged"`) {
+		t.Fatalf("identical refresh replaced markers: %s", output.String())
+	}
+	// A confirmed empty report really removes the old warning.
+	next.Diagnostics = nil
+	output.Reset()
+	if err := s.documentDiagnostics(context.Background(), json.RawMessage("3"), params); err != nil {
+		t.Fatal(err)
+	}
+	if !strings.Contains(output.String(), `"kind":"full"`) || !strings.Contains(output.String(), `"items":[]`) {
+		t.Fatalf("fixed warning was retained: %s", output.String())
+	}
+}
+
+func TestWaitingForCompleteDiagnosticsIsCancellable(t *testing.T) {
+	const uri = "file:///main.pwn"
+	s := &server{documents: map[string]*document{uri: {URI: uri, analysisReady: closedChannel(), ready: make(chan struct{})}}}
+	ctx, cancel := context.WithCancel(context.Background())
+	cancel()
+	if _, err := s.readyDiagnosticDocument(ctx, uri, true); err != context.Canceled {
+		t.Fatalf("cancellation = %v", err)
+	}
+}
