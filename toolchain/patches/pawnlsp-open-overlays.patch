@@ -0,0 +1,69 @@
+package lsp
+
+import (
+	"github.com/pawnkit/pawn-analysis/preprocess"
+	coresource "github.com/pawnkit/pawnkit-core/source"
+)
+
+// Capture immutable buffers for this analysis, rather than resolving includes only from disk.
+func (s *server) openIncludes(doc *document) preprocess.IncludeResolver {
+	open := make(map[string][]byte)
+	s.mu.Lock()
+	for _, current := range s.documents {
+		if current.Root == doc.Root {
+			open[workspacePathKey(current.Path)] = append([]byte(nil), current.text()...)
+		}
+	}
+	s.mu.Unlock()
+	return workspaceOverlayResolver{base: doc.Includes, open: open}
+}
+
+// Replace dependent document analyses without changing client-owned text or versions.
+// Use the preprocessor's dependency graph; no source-text heuristics are needed.
+func (s *server) refreshOpenDependents(changed *document) {
+	if changed == nil || changed.Root == "" {
+		return
+	}
+	s.mu.Lock()
+	s.projectRevision++
+	var pending []*document
+	for _, doc := range s.documents {
+		if doc.URI == changed.URI || doc.Root != changed.Root || !openDocumentDependsOn(doc, changed.Path) {
+			continue
+		}
+		if doc.cancel != nil {
+			doc.cancel()
+		}
+		next := &document{
+			URI: doc.URI, Path: doc.Path, Root: doc.Root, Entry: doc.Entry, Text: doc.Text, Buffer: doc.Buffer, Index: doc.Index,
+			Version: doc.Version, Includes: doc.Includes, Candidates: doc.Candidates, Names: doc.Names,
+			Revision: s.projectRevision, ready: make(chan struct{}), analysisReady: make(chan struct{}),
+		}
+		s.documents[doc.URI] = next
+		pending = append(pending, next)
+	}
+	s.mu.Unlock()
+	for _, doc := range pending {
+		s.schedulePublishAfter(doc, s.snapshot, documentPublishDebounce)
+	}
+}
+
+func openDocumentDependsOn(doc *document, path string) bool {
+	if doc.analysisReady != nil {
+		select {
+		case <-doc.analysisReady:
+		default:
+			return true // Initial analysis has not established the dependencies yet.
+		}
+	}
+	if doc.Analysis == nil || doc.Analysis.Preprocess == nil {
+		return true
+	}
+	for _, file := range doc.Analysis.Preprocess.Files {
+		filename, err := coresource.URI(file.URI).Filename()
+		if err == nil && workspacePathKey(filename) == workspacePathKey(path) {
+			return true
+		}
+	}
+	return false
+}
