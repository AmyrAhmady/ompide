diff --git a/lsp/interactive_cache.go b/lsp/interactive_cache.go
new file mode 100644
index 0000000..2fa6084
--- /dev/null
+++ b/lsp/interactive_cache.go
@@ -0,0 +1,204 @@
+package lsp
+
+import (
+	"context"
+	"maps"
+	"sort"
+	"strings"
+	"sync"
+
+	analysis "github.com/pawnkit/pawn-analysis"
+	"github.com/pawnkit/pawn-analysis/preprocess"
+	"github.com/pawnkit/pawn-analysis/symbol"
+	coresource "github.com/pawnkit/pawnkit-core/source"
+)
+
+// A completed analysis stays immutable and usable while its replacement is pending.
+// The live document supplies prefixes, call arguments and UTF-16 cursor positions.
+type interactiveCache struct {
+	doc               *document
+	candidates        []cachedCandidate
+	mu                sync.Mutex
+	signatures        map[string]signatureInformation
+	signatureRevision uint64
+}
+
+type cachedCandidate struct {
+	name   string
+	folded string
+	item   map[string]any
+	table  *symbol.Table
+	symbol symbol.Symbol
+}
+
+func buildInteractiveCache(ctx context.Context, doc *document) (*interactiveCache, error) {
+	text := doc.text()
+	cached := &document{
+		URI: doc.URI, Path: doc.Path, Root: doc.Root, Entry: doc.Entry, Text: text,
+		Index: coresource.NewLineIndex(string(text)), Version: doc.Version,
+		Analysis: doc.Analysis, Includes: doc.Includes, Candidates: doc.Candidates, Names: doc.Names,
+	}
+	cache := &interactiveCache{doc: cached, signatures: make(map[string]signatureInformation)}
+	for _, table := range navigationTables(doc.Analysis) {
+		for _, item := range table.Symbols {
+			if err := ctx.Err(); err != nil {
+				return nil, err
+			}
+			cache.candidates = append(cache.candidates, cachedCandidate{
+				name: item.Name, folded: strings.ToLower(item.Name), table: table, symbol: item,
+				item: map[string]any{
+					"label": item.Name, "kind": completionSymbolKind(item.Kind), "detail": symbolSummary(item),
+					"sortText": "0_" + strings.ToLower(item.Name),
+					"data":     completionData{Kind: "local", URI: doc.URI, Source: symbolSourceURI(doc.Analysis, item), Name: item.Name, Start: int(item.Span.Start)},
+				},
+			})
+		}
+	}
+	if doc.Analysis != nil && doc.Analysis.Preprocess != nil {
+		for _, macro := range doc.Analysis.Preprocess.Macros {
+			if err := ctx.Err(); err != nil {
+				return nil, err
+			}
+			detail, kind := "macro", 21
+			if macro.Kind == preprocess.MacroFunctionLike {
+				detail, kind = macroSignature(macro), 3
+			}
+			cache.candidates = append(cache.candidates, cachedCandidate{
+				name: macro.Name, folded: strings.ToLower(macro.Name),
+				item: map[string]any{
+					"label": macro.Name, "kind": kind, "detail": detail, "sortText": "1_" + strings.ToLower(macro.Name),
+					"data": completionData{Kind: "macro", URI: doc.URI, Name: macro.Name},
+				},
+			})
+		}
+	}
+	sort.SliceStable(cache.candidates, func(i, j int) bool { return completionItemLess(cache.candidates[i].item, cache.candidates[j].item) })
+	return cache, ctx.Err()
+}
+
+func (s *server) interactiveDocument(ctx context.Context, uri string) (*document, *interactiveCache, error) {
+	s.mu.Lock()
+	live, cache := s.documents[uri], s.interactive[uri]
+	s.mu.Unlock()
+	if live == nil || cache != nil {
+		return live, cache, ctx.Err()
+	}
+	doc, err := s.readyDocumentContext(ctx, uri)
+	if err != nil || doc == nil {
+		return doc, nil, err
+	}
+	s.mu.Lock()
+	live, cache = s.documents[uri], s.interactive[uri]
+	s.mu.Unlock()
+	// Also support documents constructed directly by protocol/unit-test consumers.
+	if cache == nil && doc.Analysis != nil {
+		cache, err = buildInteractiveCache(ctx, doc)
+	}
+	return live, cache, err
+}
+
+func (cache *interactiveCache) completionItems(live []byte, prefix string, offset int) []map[string]any {
+	oldOffset, locals := cachedSourceOffset(cache.doc.Text, live, offset)
+	functionName := ""
+	if locals && cache.doc.Analysis != nil && cache.doc.Analysis.Parse != nil {
+		functionName = containingFunctionName(cache.doc.Analysis.Parse.Syntax(), oldOffset)
+	}
+	scopes := make(map[*symbol.Table]symbol.ID)
+	for _, table := range navigationTables(cache.doc.Analysis) {
+		function, _ := callableByName(table, functionName)
+		scopes[table] = function.FuncScope
+	}
+	folded := strings.ToLower(prefix)
+	seen := make(map[string]bool)
+	items := make([]map[string]any, 0)
+	for _, candidate := range cache.candidates {
+		if seen[candidate.name] || !strings.HasPrefix(candidate.folded, folded) {
+			continue
+		}
+		if candidate.table != nil && !completionSymbolVisible(candidate.table, candidate.symbol, oldOffset, scopes[candidate.table]) {
+			continue
+		}
+		seen[candidate.name] = true
+		items = append(items, candidate.item)
+	}
+	return items
+}
+
+// Map the unchanged prefix/suffix to their original offsets. A cursor
+// inside the edit is ambiguous, so only file-level candidates are used there.
+func cachedSourceOffset(old, live []byte, offset int) (int, bool) {
+	prefix := 0
+	for prefix < len(old) && prefix < len(live) && old[prefix] == live[prefix] {
+		prefix++
+	}
+	if offset <= prefix {
+		return offset, true
+	}
+	suffix := 0
+	for suffix < len(old)-prefix && suffix < len(live)-prefix && old[len(old)-1-suffix] == live[len(live)-1-suffix] {
+		suffix++
+	}
+	if offset >= len(live)-suffix {
+		return len(old) - (len(live) - offset), true
+	}
+	return prefix, false
+}
+
+func (s *server) cachedCallSignature(cache *interactiveCache, name string) (signatureInformation, bool) {
+	s.mu.Lock()
+	revision := s.interactiveRevision
+	s.mu.Unlock()
+	cache.mu.Lock()
+	defer cache.mu.Unlock()
+	if cache.signatureRevision != revision {
+		cache.signatureRevision = revision
+		clear(cache.signatures)
+	}
+	if signature, ok := cache.signatures[name]; ok {
+		return signature, true
+	}
+	signature, ok := s.callSignature(cache.doc, name)
+	if ok {
+		cache.signatures[name] = signature
+	}
+	return signature, ok
+}
+
+// Resolve details from the same completed snapshot that supplied the candidate.
+func (s *server) completionDocument(uri string) *document {
+	s.mu.Lock()
+	cache := s.interactive[uri]
+	s.mu.Unlock()
+	if cache != nil {
+		return cache.doc
+	}
+	return s.readyDocument(uri)
+}
+
+// Interactive requests must never wait for diagnostics or workspace indexing.
+// Unchanged workspace results and the last complete open-buffer analyses remain
+// usable until the next idle refresh replaces them.
+func (s *server) availableWorkspaceResults() map[coresource.URI]*analysis.Result {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	results := make(map[coresource.URI]*analysis.Result)
+	for _, index := range s.workspaces {
+		var graph *analysis.Result
+		select {
+		case <-index.ready:
+			maps.Copy(results, index.files)
+			graph = index.graph
+		default:
+			graph = index.previous
+		}
+		if graph != nil && graph.Registry != nil {
+			if uri, ok := graph.Registry.URI(graph.File); ok {
+				results[uri] = graph
+			}
+		}
+	}
+	for uri, cache := range s.interactive {
+		results[coresource.URI(uri)] = cache.doc.Analysis
+	}
+	return results
+}
