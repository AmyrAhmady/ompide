+// A raw-source consumer cannot resolve macros from includes. The adjacent
+// name<text> spelling followed by a case delimiter is nevertheless unambiguous:
+// a relational greater-than expression would require a right operand after >.
+// Keep the payload opaque rather than interpreting its words as expressions.
+func (p *parser[N, S]) angleCaseMacroEnd() (int, bool) {
+	first := p.cur()
+	opening := p.peek(1)
+	if first.Kind != token.Identifier || opening.Kind != token.Lt || first.End.Offset != opening.Start.Offset {
+		return 0, false
+	}
+	for i := 2; ; i++ {
+		current := p.peek(i)
+		if current.Start.Line != first.Start.Line {
+			return 0, false
+		}
+		switch current.Kind {
+		case token.EOF, token.Semicolon, token.LBrace, token.RBrace, token.Colon:
+			return 0, false
+		case token.Gt:
+			next := p.peekKind(i + 1)
+			if i > 2 && (next == token.Colon || next == token.Comma || next == token.DotDot) {
+				return current.End.Offset, true
+			}
