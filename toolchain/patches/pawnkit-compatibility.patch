+// Textual arrow invocations are preprocessor syntax, not subtraction followed by
+// a greater-than expression. Discover only a complete, balanced statement on
+// this line; incomplete invocations still use ordinary error recovery.
+func (p *parser[N, S]) arrowMacroEnd() (int, bool) {
+	if p.curKind() != token.Identifier {
+		return 0, false
+	}
+	arrow, depth := false, 0
+	for i := 1; ; i++ {
+		current := p.peek(i)
+		if current.Start.Line != p.cur().Start.Line {
+			return 0, false
+		}
+		switch current.Kind {
+		case token.EOF, token.LBrace, token.RBrace:
+			return 0, false
+		case token.LParen, token.LBracket:
+			depth++
+		case token.RParen, token.RBracket:
+			depth--
+			if depth < 0 {
+				return 0, false
