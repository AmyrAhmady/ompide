+package parser
+
+import "testing"
+
+func TestRawMacroFormsRemainLosslessInBothTrees(t *testing.T) {
+	t.Parallel()
+	for _, source := range []string{
+		"main(){switch(value){case HASH<Next page>:{ShowDialog(playerid, page[playerid] += 1);}}}",
+		"main(){switch(value){case hash<One>, hash<Two>: return 1; default: return 0;}}",
+		"main(){switch(value){case FIRST<One> .. LAST<Two>: return 1;}}",
+		"main(){switch(value){case left < middle > right: return 1; case (_:1): return 2;}}",
+		"main(){extract params -> new first, second; else return 0; Use(first, second);}",
+		"main(){if(ready){unpack input -> new first; else {return 0;}}}",
+		"Packet:207(playerid, Stream:stream) { return 1; }",
+		"Link:short->long; main(){}",
+	} {
+		file := Parse([]byte(source))
+		compact := ParseCompact([]byte(source), ParseOptions{})
+		if file.Broken || file.HasParseErrors() || compact.HasParseErrors() {
+			t.Fatalf("%s: full=%+v compact=%+v", source, file.Diagnostics, compact.Diagnostics)
+		}
+		if string(file.Source) != source || string(compact.Source) != source {
+			t.Fatal("parser changed source")
+		}
+		if file.Root.End != compact.Expand().Root.End {
+			t.Fatal("compact and full trees disagree on source extent")
+		}
+	}
+}
+
+func TestMalformedMacroBoundariesStillReportErrors(t *testing.T) {
+	t.Parallel()
+	for _, source := range []string{
+		"main(){switch(value){case HASH<Next page> return 1;}}",
+		"main(){switch(value){case left < : return 1;}}",
+		"main(){switch(value){case left > : return 1;}}",
+		"main(){switch(value){case HASH<>: return 1;}}",
+		"Packet:207(playerid { return 1; }",
+		"main(){ extract params -> new first; else }",
+	} {
+		if file := Parse([]byte(source)); len(file.Diagnostics) == 0 {
+			t.Fatalf("accepted malformed source: %s", source)
+		}
+	}
+}
