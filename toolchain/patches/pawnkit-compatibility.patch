+func (s *state) macroStyleHeader(n *parser.Node) bool {
+	if tag := n.Field("tag"); tag != nil {
+		// Built-in scalar tags are ordinary language syntax. Other tag-shaped
+		// prefixes may be textual macros supplied by an include.
+		name := ""
+		if len(tag.Children) > 0 {
+			name = tag.Children[0].Text(s.source)
+		}
+		if name != "Float" && name != "bool" && name != "_" {
+			return true
+		}
+	}
+	for _, child := range n.Children {
+		if child == n.Field("name") {
+			break
+		}
+		if child.Kind == parser.KindIdentifier && child.Tok.Kind == token.Identifier {
+			return true
+		}
+	}
+	return false
