+package pawnfmt_test
+
+import (
+	"bytes"
+	"github.com/pawnkit/pawnfmt"
+	"strings"
+	"testing"
+)
+
+func TestFormatMacroFormsPreservesTokensCommentsAndConverges(t *testing.T) {
+	t.Parallel()
+	for _, source := range []string{
+		"// keep header\nmain(){switch(value){case HASH<Next page>:{ShowDialog(playerid, page[playerid] += 1);}}}\n",
+		"main(){extract params -> new first, second; else {return 0;} Use(first,second);}",
+		"Packet:207(playerid, Stream:stream) // keep packet\n{return 1;}",
+		"Link:short->long; main(){}",
+		"enum _:Size { First, Last }; main(){}",
+		"enum Float:Values { First }; main(){}",
+		"main(){switch(value){case left < middle > right: return 1;}}",
+		"#define COUNT 2\nmain(){new text[128]; format(text,sizeof text,#COUNT \" a very long string which must not cause stringizing to move to a new directive line\");}",
+	} {
+		formatted, err := pawnfmt.Format([]byte(source), pawnfmt.Options{TabSize: 4})
+		if err != nil {
+			t.Fatalf("format %s: %v", source, err)
+		}
+		again, err := pawnfmt.Format(formatted, pawnfmt.Options{TabSize: 4})
+		if err != nil || !bytes.Equal(again, formatted) {
+			t.Fatalf("not idempotent: %s (%v)", formatted, err)
+		}
+		for _, marker := range []string{"HASH<Next page>", "extract params -> new first, second;", "Packet:207", "Link:short->long", "_:Size", "Float:Values", "// keep header", "// keep packet"} {
+			if strings.Contains(source, marker) && !bytes.Contains(formatted, []byte(marker)) {
+				t.Fatalf("lost macro/tag/comment %q: %s", marker, formatted)
+			}
+		}
+	}
+}
+
+func TestStrictFormatStillRefusesBrokenSource(t *testing.T) {
+	t.Parallel()
+	for _, source := range []string{"main(){ return 1 + ; }", "main(){switch(value){case HASH<Next page> return 1;}}"} {
+		if output, err := pawnfmt.Format([]byte(source), pawnfmt.Options{}); err == nil || output != nil {
+			t.Fatalf("formatted broken source: %s", output)
+		}
+	}
+}
+
+func TestStringizingArgumentsKeepPreprocessorLineBoundaries(t *testing.T) {
+	t.Parallel()
+	source := []byte("#define COUNT 2\nmain(){new text[128]; format(text,sizeof text,#COUNT \" a very long string which must not cause stringizing to move to a new directive line\");}")
+	formatted, err := pawnfmt.Format(source, pawnfmt.Options{TabSize: 4})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !bytes.Contains(formatted, []byte("format(text,sizeof text,#COUNT")) {
+		t.Fatalf("reflowed stringizing argument: %s", formatted)
+	}
+}
+
+func TestMacroFunctionHeaderKeepsPhysicalLinesWhileBodyFormats(t *testing.T) {
+	t.Parallel()
+	source := []byte("#define Callback:%0(%1) forward %0(%1); public %0(%1)\nCallback:Complete(first, second, third, fourth, fifth, sixth, seventh, eighth, ninth, tenth) // keep header\n{new value=1;return value;}")
+	formatted, err := pawnfmt.Format(source, pawnfmt.Options{TabSize: 4})
+	if err != nil {
+		t.Fatal(err)
+	}
+	for _, marker := range []string{"Callback:Complete(first, second, third, fourth, fifth, sixth, seventh, eighth, ninth, tenth)", "// keep header", "new value = 1;"} {
+		if !bytes.Contains(formatted, []byte(marker)) {
+			t.Fatalf("lost header layout or body formatting: %s", formatted)
+		}
+	}
+}
